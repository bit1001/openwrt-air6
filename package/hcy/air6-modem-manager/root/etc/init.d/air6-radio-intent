#!/bin/sh /etc/rc.common
# Independent service: radio worker stops the data manager during RF changes.
START=94
STOP=03
USE_PROCD=1
start_service() {
    [ "$(cat /tmp/sysinfo/board_name)" = softbank,air6 ] || return 1
    [ "$(uci -q get air6_modem.main.radio_off)" = 1 ] || return 0
    procd_open_instance
    procd_set_param command /usr/libexec/air6-radio-intent
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
