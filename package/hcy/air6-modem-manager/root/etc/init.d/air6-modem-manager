#!/bin/sh /etc/rc.common
START=96
STOP=04
USE_PROCD=1
EXTRA_COMMANDS="dial hang"
EXTRA_HELP="        dial    Enable cellular connection policy
        hang    Persistently stop cellular data"
start_service() {
    [ "$(cat /tmp/sysinfo/board_name)" = softbank,air6 ] || return 1
    if [ "$(uci -q get air6_modem.main.radio_off)" = 1 ]; then
        return 0
    fi
    [ "$(uci -q get air6_modem.main.enabled)" = 1 ] || return 0
    [ "$(uci -q get air6_modem.main.manual_stop)" != 1 ] || return 0
    procd_open_instance
    procd_set_param command /usr/libexec/air6-modem-policy
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
dial() {
    [ "$(uci -q get air6_modem.main.radio_off)" != 1 ] || {
        echo "Enable radio before requesting data connection" >&2
        return 75
    }
    [ "$(uci -q get qmodem.main.enable_dial)" != 1 ] || {
        echo "QModem policy must be disabled before own manager takes over" >&2
        return 75
    }
    uci set network.modem5g.auto=1
    uci commit network
    uci set air6_modem.main.manual_stop=0
    uci commit air6_modem
    restart
}
hang() {
    uci set network.modem5g.auto=0
    uci commit network
    uci set air6_modem.main.manual_stop=1
    uci commit air6_modem
    stop
    ifdown modem5g
}
reload_service() { restart; }
