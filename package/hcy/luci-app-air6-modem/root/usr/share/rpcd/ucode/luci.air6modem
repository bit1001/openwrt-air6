#!/usr/bin/env ucode
/* AIR6 native LuCI modem management.
 * Original LuCI integration adapted from FiberHome LG6851F (Apache-2.0).
 * Routine telemetry reads the bounded native RIL collector. AT is explicit only.
 */
'use strict';

import { popen, readfile, writefile } from 'fs';
import { cursor } from 'uci';

const CLI    = '/usr/bin/mipc_wan_cli';
const ATCLI  = '/usr/bin/air6-modem-at';
const SMSCLI = '/usr/bin/air6-modem-sms-send';
const SNAPSHOT_MAX_AGE = 90;
const IFACE  = 'modem5g';

/* 本固件没有 fiberhome 的 board_name；有厂商 mipc_wan_cli 才说明是这颗集成模组。 */
function board_ok() {
	return readfile(CLI) != null;
}

function quote(value) {
	return `'${replace('' + value, "'", "'\\''")}'`;
}

function capture(argv, seconds) {
	let command = join(' ', map(argv, quote));
	/* busybox 的 timeout applet 在 air6_defconfig 里打开了；万一没编进去也照跑。 */
	if (readfile('/usr/bin/timeout') != null)
		command = `/usr/bin/timeout ${seconds || 12} ${command}`;
	let pipe = popen(`${command} 2>&1`, 'r');
	let output = pipe?.read?.('all') || '';
	let code = pipe?.close?.();
	return { output: trim(output), code: code || 0 };
}

function cli(option, arg) {
	let argv = [ CLI, '--' + option ];
	if (arg != null)
		push(argv, '' + arg);
	/* mipc_wan_cli 独占 ttyCMIPC6；和状态采集脚本共用一把锁，避免互相打断。 */
	let runner = 'exec 9>/var/lock/luci-air6modem-control.lock; ' +
		'/usr/bin/flock -n 9 || { echo __MODEM_LOCK_BUSY__; exit 75; }; ' +
		'/bin/sleep 0.2; ' + join(' ', map(argv, quote));
	let result = capture([ '/bin/sh', '-c', runner ], 15);
	if (index(result.output, '__MODEM_LOCK_BUSY__') >= 0)
		return { output: 'Modem command channel is busy; retry shortly', code: 75 };
	return result;
}

function valid_at(command) {
	return type(command) == 'string' && length(command) >= 2 && length(command) <= 512 &&
		match(command, /^AT[+A-Z0-9?=,._*#;:" ()\/-]*$/i);
}

function at(command) {
	if (!valid_at(command))
		return { output: '', code: 22, error: 'AT command contains unsupported characters' };
	return capture([ ATCLI, command ], 18);
}

function network_state() {
	let result = capture([ '/bin/ubus', 'call', `network.interface.${IFACE}`, 'status' ], 5);
	let state = null;
	try { state = json(result.output); } catch (e) {}
	return state;
}

function cached_modem_state() {
    /* Coalesce requests in the background worker, without blocking rpcd. */
    writefile('/var/run/air6-modem-status.request', '1');
    try { return json(readfile('/tmp/air6-modem-status.json') || '{}'); }
    catch (e) { return {}; }
}

function session_ambr(network, rat) {
	let kind = rat == 'NR5G-SA' ? '5gs' : (rat == 'LTE' || rat == 'NR5G-NSA' ? 'eps' : null);
	if (!kind || !network?.up || !network?.l3_device || network?.data?.cid == null)
		return null;

	let sample;
	try { sample = json(readfile('/tmp/air6-modem-ambr.json') || '{}'); }
	catch (e) { return null; }
	if (!sample?.rates || sample.kind != kind ||
	    sample.device != network.l3_device || ('' + sample.rates.cid) != ('' + network.data.cid))
		return null;

	let now = time();
	let age = now - +(sample.updated || 0);
	let delta = now - +(network.uptime || 0) - +(sample.connected_since || 0);
	return age >= 0 && age <= 180 && delta >= -2 && delta <= 2 ? sample.rates : null;
}

function status() {
	if (!board_ok())
		return { available: false, error: 'mipc_wan_cli not found on this firmware' };

	let network_json = network_state();

	let cached = cached_modem_state();
	let age = time() - +(cached.UPDATED || 0);
	if (!cached.UPDATED || age < 0 || age > SNAPSHOT_MAX_AGE)
		return { available: true, initializing: true, network: network_json,
			error: 'Waiting for the modem status collector' };

	return {
		available: true,
		cached: true,
		cache_age: age,
		source: cached.source || "qlril-ubus",
		api_errors: cached.api_errors || {},
		carriers: cached.carriers || [],
		ca: cached.ca || {},
		session_ambr: session_ambr(network_json, cached.RAT),
		imei: cached.IMEI || '',
		imsi: cached.IMSI || '',
		iccid: cached.ICCID || '',
		sim: cached.SIM || 'unknown',
		operator: cached.OPERATOR || '',
		registration: cached.REGISTRATION || 'unknown',
		register_detail: cached.REGISTERED || 'NO',
		rat: cached.RAT_RAW || cached.RAT || 'UNKNOWN',
		signal: cached.SIGNAL || '',
		radio: cached.RADIO || '',
		temperature: cached.TEMP || '',
		band: cached.BAND || '',
		pci: cached.PCI || '',
		arfcn: cached.ARFCN || '',
		tac: cached.TAC || '',
		cellid: cached.CELLID || '',
		cesq: join(' · ', filter([
			cached.RSSI ? `RSSI=${cached.RSSI} dBm` : null,
			cached.RSRP ? `RSRP=${cached.RSRP} dBm` : null,
			cached.RSRQ ? `RSRQ=${cached.RSRQ} dB` : null,
			cached.SINR ? `SINR=${cached.SINR} dB` : null
		], v => v != null)),
		network: network_json
	};
}

const methods = {
    get_control: { call: function() {
        try { return json(readfile('/tmp/air6-modem-control-job.json') || '{"status":"idle"}'); }
        catch (e) { return {status:'0', message:'Cannot read control worker state'}; }
    } },
    get_ca: { call: function() {
        let result = capture(['/usr/libexec/air6-modem-ca', 'get'], 35);
        try { return json(result.output); } catch (e) { return {status:'0', message:'Cannot read NR CA settings'}; }
    } },
    set_ca: { args: { mode: '' }, call: function(req) {
        let mode = req.args?.mode;
        if (index(['on', 'off', '2', '3', '4'], mode) < 0)
            return {status:'0', message:'Invalid NR CA setting'};
        let result = capture(['/usr/libexec/air6-modem-control-submit', 'ca', mode], 5);
        try { return json(result.output); } catch (e) { return {status:'0', message:'Cannot start NR CA change'}; }
    } },
    set_bands: { args: { band_class: '', bands: [] }, call: function(req) {
        let a = req.args || {};
        if (index(['LTE','NR'], a.band_class) < 0 || type(a.bands) != 'array' ||
            !length(a.bands) || length(a.bands) > 256 ||
            length(filter(a.bands, b => type(b) != 'int' || b < 1 || b > 1024)))
            return {code:22, error:'Invalid band selection'};
        let spec = sprintf('%J', {band_class:a.band_class,lock_band:join(',',a.bands)});
        let result = capture(['/usr/libexec/air6-modem-control-submit','band',spec],5);
        try { return json(result.output); } catch(e) { return {code:result.code || 5,error:result.output}; }
    } },
    get_apn: { call: function() {
        let uci = cursor();
        return { automatic: uci.get('network', IFACE, 'auto_conf') == '1',
            apn: uci.get('network', IFACE, 'apn') || '',
            username: uci.get('network', IFACE, 'username') || '',
            password_set: length(uci.get('network', IFACE, 'password') || '') > 0,
            auth: +(uci.get('network', IFACE, 'auth') || 0),
            iptype: +(uci.get('network', IFACE, 'iptype') || 3) };
    } },
    save_apn: { args: { automatic: true, apn: '', username: '', password: '',
        replace_password: false, auth: 0, iptype: 3 }, call: function(req) {
        let a = req.args || {};
        let uci = cursor();
        if (uci.get('qmodem', 'main', 'enable_dial') == '1')
            return { code: 75, error: 'QModem still owns connection settings' };
        if (uci.get('network', IFACE, 'proto') != 'ql_datacall')
            return { code: 22, error: 'Unexpected cellular interface protocol' };
        let apn = '' + (a.apn || '');
        let user = '' + (a.username || '');
        let password = '' + (a.password || '');
        if ((!a.automatic && !match(apn, /^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$/)) ||
            length(user) > 128 || length(password) > 128 ||
            !match(user, /^[ -~]*$/) || !match(password, /^[ -~]*$/) ||
            index([0, 1, 2], +a.auth) < 0 || index([1, 2, 3], +a.iptype) < 0)
            return { code: 22, error: 'Invalid APN settings' };
        uci.set('network', IFACE, 'auto_conf', a.automatic ? '1' : '0');
        if (!a.automatic) {
            uci.set('network', IFACE, 'apn', apn);
            uci.set('network', IFACE, 'username', user);
            if (a.replace_password) uci.set('network', IFACE, 'password', password);
            uci.set('network', IFACE, 'auth', '' + a.auth);
            uci.set('network', IFACE, 'iptype', '' + a.iptype);
        } else {
            /* Automatic SIM provisioning must not inherit a previous carrier's APN/PLMN. */
            uci.delete('network', IFACE, 'apn');
            uci.delete('network', IFACE, 'plmn');
        }
        if (!uci.commit('network')) return { code: 5, error: 'Cannot save network settings' };
        return { code: 0, output: 'APN settings saved; reconnect to apply' };
    } },
    get_bands: { call: function() {
        let result = capture([ '/usr/bin/air6-nw-api', '--bands' ], 20);
        let data;
        try { data = json(result.output); } catch (e) {}
        if (result.code != 0 || type(data) != 'object')
            return { error: 'Native band query failed', code: result.code || 5 };
        return data;
    } },
	get_status: { call: function() { return status(); } },

    /* Read the same native RIL cache as status; never poll AT for cells. */
    get_cells: { call: function() {
        let cached = cached_modem_state();
        let age = time() - +(cached.UPDATED || 0);
        return { source: 'qlril-ubus', stale: !cached.UPDATED || age < 0 || age > SNAPSHOT_MAX_AGE,
            cache_age: cached.UPDATED && age >= 0 ? age : null,
            cells: cached.cells || [], carriers: cached.carriers || [],
            ca: cached.ca || {}, api_errors: cached.api_errors || {},
            serving: { output: '' }, engineering: { output: '' },
            note: 'Native RIL API measurements; no AT polling' };
    } },

	list_sms: { call: function() {
		let mode = at('AT+CMGF=1');
		let charset = at('AT+CSCS="UCS2"');
		let storage = at('AT+CPMS?');
		let messages = at('AT+CMGL="ALL"');
		return {
			success: mode.code == 0 && charset.code == 0 && messages.code == 0,
			storage: storage.output,
			output: messages.code != 0 ? (messages.output || 'SMS query failed') :
				(index(messages.output, '+CMGL:') >= 0 ? messages.output : 'No stored messages')
		};
	} },

	get_smsc: { call: function() { return at('AT+CSCA?'); } },

	delete_sms: { args: { index: 0 }, call: function(req) {
		let index = +req.args?.index;
		if (index < 0 || index > 65535) return { code: 22, error: 'Invalid SMS index' };
		return at(`AT+CMGD=${index}`);
	} },

	set_smsc: { args: { number: '' }, call: function(req) {
		let number = '' + (req.args?.number || '');
		if (!match(number, /^\+?[0-9]{3,20}$/)) return { code: 22, error: 'Invalid SMS center number' };
		return at(`AT+CSCA="${number}"`);
	} },

	send_sms: { args: { number: '', text: '' }, call: function(req) {
		let number = '' + (req.args?.number || '');
		let body = '' + (req.args?.text || '');
		if (!match(number, /^\+?[0-9]{3,20}$/)) return { code: 22, error: 'Invalid recipient number' };
		if (!length(body) || length(body) > 160 || !match(body, /^[ -~]*$/))
			return { code: 22, error: 'Use 1-160 printable GSM/ASCII characters' };
		let result = capture([ SMSCLI, number, body ], 25);
		let accepted = result.code == 0 && index(result.output, 'qlril') >= 0;
		return {
			output: result.output,
			code: accepted ? 0 : 5,
			success: accepted,
			error: accepted ? null : 'Modem did not confirm SMS submission'
		};
	} },

	run_at: { args: { command: '' }, call: function(req) { return at(req.args?.command || ''); } },

	get_network: { call: function() {
		let state = capture([ '/bin/ubus', 'call', `network.interface.${IFACE}`, 'status' ], 5);
		let config = capture([ '/sbin/uci', '-q', 'show', `network.${IFACE}` ], 5);
        config.output = join('\n', map(split(config.output, '\n'), line =>
            match(line, /\.(password|pincode)=/) ? replace(line, /=.*/, "='[hidden]'") : line));
		let cached = cached_modem_state();
		return { status: state.output, config: config.output,
			radio: cached.RADIO || '', rat: cached.RAT_RAW || cached.RAT || 'UNKNOWN', cached: true };
	} },

	set_radio: { args: { enabled: true }, call: function(req) {
		let result = capture(['/usr/libexec/air6-modem-control-submit', 'radio', req.args?.enabled ? '1' : '0'], 5);
        try { return json(result.output); } catch(e) { return {code:result.code || 5,error:result.output}; }
	} },

    set_rat: { args: { mode: 21 }, call: function(req) {
        let mode = +req.args?.mode;
        if (index([3,15,19,21], mode) < 0) return {code:22,error:'Invalid RAT mode'};
        let result = capture(['/usr/libexec/air6-modem-control-submit','rat',''+mode],5);
        try { return json(result.output); } catch(e) { return {code:result.code || 5,error:result.output}; }
    } },

	ifup: { call: function() { return capture([ '/etc/init.d/air6-modem-manager', 'dial' ], 25); } },
	ifdown: { call: function() { return capture([ '/etc/init.d/air6-modem-manager', 'hang' ], 25); } }
};

return { 'luci.air6modem': methods };

