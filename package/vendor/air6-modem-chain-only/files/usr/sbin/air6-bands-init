#!/bin/sh
# Apply the full supported set once per fresh configuration, then preserve users' choices.
set -u
marker=/etc/air6/bands-initialized
state=/etc/modem5g-lock.state
[ ! -f "$marker" ] || exit 0
mkdir /tmp/air6-bands-init.lock 2>/dev/null || exit 0
trap 'rmdir /tmp/air6-bands-init.lock 2>/dev/null' EXIT
attempt=0
while [ "$attempt" -lt 12 ]; do
    # A verified explicit user request takes precedence, including after a failed init.
    if [ -f "$state" ] && grep -qx 'STATUS=verified' "$state"; then
        mkdir -p /etc/air6
        printf 'preserved-user-selection\n' > "$marker"
        exit 0
    fi
    attempt=$((attempt + 1))
    sleep 15
    ubus list ril 2>/dev/null | grep -qx ril || continue
    if /usr/bin/air6-modem-chain-lock apply-bands \
        1,3,5,7,8,20,28,38,40,41,42,43 \
        1,3,5,7,8,20,28,38,40,41,77,78,79 > /tmp/air6-bands-init.output 2>&1; then
        mkdir -p /etc/air6
        printf 'full-supported-verified\n' > "$marker.new" && mv "$marker.new" "$marker"
        logger -t air6-bands-init 'All supported LTE/NR bands applied and read back; initialization complete'
        exit 0
    fi
    logger -t air6-bands-init "Band initialization not yet verified (attempt $attempt); will retry"
done
logger -t air6-bands-init -p daemon.err 'Band initialization failed; marker not saved, retry on next boot'
exit 1
