#!/bin/sh /etc/rc.common
# mtwifi ubus service.
#
# Replaces the vendor wireless bring-up path:
#   /etc/init.d/wifi -> netifd mtkwifi.sh -> /sbin/wifi-mtk (Lua)
# with:
#   this service (daemon) -> ubus "mtwifi"; the netifd wireless driver
#   (/lib/netifd/wireless/mt_dbdc.sh) invokes /usr/sbin/mtwifi directly.
#
# Start after S12rpcd and before S20network so netifd can reach the daemon.

START=19
STOP=20
USE_PROCD=1

start_service() {
	# A fresh image has profiles but no UCI wireless file yet.
	[ -s /etc/wireless/l1profile.dat ] || return 0

	# The daemon writes hostapd configs here and expects the directory to
	# exist; /var/run is a tmpfs that starts empty on every boot.
	mkdir -p /var/run/hostapd

	# Regenerate only when the config is missing or has lost its interfaces
	# (e.g. a reset left wifi-device sections behind without wifi-iface).
	# A config with interfaces is preserved so user edits survive restarts.
	if ! grep -q '^config wifi-iface' /etc/config/wireless 2>/dev/null; then
		/usr/sbin/mtwifi detect /tmp/wireless.detect || return 1
		mv -f /tmp/wireless.detect /etc/config/wireless
	fi

	procd_open_instance
	procd_set_param command /usr/sbin/mtwifi
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}