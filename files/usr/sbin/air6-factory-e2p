#!/bin/sh
# Select the factory MT7990 EEPROM before loading the Wi-Fi modules.
. /lib/functions/system.sh
set -e

dst=/etc/air6-vendor618/firmware
fallback=/etc/air6-wifi/factory-e2p.bin
template=/etc/wireless/mediatek/e2p
mkdir -p "$dst"
tmp=$(mktemp "$dst/.e2p.XXXXXX")
trap 'rm -f "$tmp"' EXIT

valid_e2p() {
	[ -f "$1" ] &&
	[ "$(wc -c < "$1")" -eq 7680 ] &&
	[ "$(hexdump -v -n 2 -e '2/1 "%02x"' "$1")" = 9079 ] &&
	[ -n "$(dd if="$1" bs=256 skip=1 2>/dev/null | tr -d '\000\377' | head -c 1 | hexdump -v -e '1/1 "%02x"')" ]
}

read_raw_e2p() {
	local part metadata entry block
	part=$(find_mmc_part "$1") || return 1
	[ -b "$part" ] || return 1

	# The factory metadata may have a second copy one 256 KiB block later.
	for metadata in 0 64; do
		entry=$(dd if="$part" bs=4096 skip="$metadata" count=1 2>/dev/null |
			tr -d '\000\r' | sed -n 's/^e2p=\([1-7]\),7680$/\1/p' | head -n 1)
		case "$entry" in
			[1-7]) block=$entry ;;
			*) continue ;;
		esac
		if dd if="$part" of="$tmp" bs=256 skip="$((block * 1024))" count=30 2>/dev/null &&
			valid_e2p "$tmp"; then
			return 0
		fi
	done
	return 1
}

if read_raw_e2p raw1; then
	source=raw1
elif read_raw_e2p raw2; then
	source=raw2
elif valid_e2p "$fallback"; then
	cp "$fallback" "$tmp"
	source=local-backup
elif valid_e2p "$template"; then
	cp "$template" "$tmp"
	source=default-template
else
	echo 'AIR6: no valid MT7990 Wi-Fi EEPROM' >&2
	exit 1
fi

if ! cmp -s "$tmp" "$dst/e2p"; then
	chmod 0644 "$tmp"
	mv -f "$tmp" "$dst/e2p"
fi
echo "AIR6: loaded Wi-Fi calibration from $source"
